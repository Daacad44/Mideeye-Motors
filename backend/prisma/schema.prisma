// Mideeye Motors — data model
// PostgreSQL + Prisma. ImageKit is the single source of truth for images:
// only the ImageKit fileId/filePath/url are stored here; transformed
// delivery URLs are derived (server or client) from filePath + a named
// preset (hero/card/gallery/team/blogcover/thumb/logo) via `tr=` params.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  SUV
  Sedan
  Luxury
  Pickup
  Electric
  Van
}

enum Transmission {
  Automatic
  Manual
}

enum FuelType {
  Petrol
  Diesel
  Hybrid
  Electric
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  STAFF
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
}

model Vehicle {
  id            String       @id @default(cuid())
  title         String
  slug          String       @unique
  category      Category
  brand         String
  year          Int

  pricePerDay   Int
  pricePerWeek  Int
  pricePerMonth Int

  transmission  Transmission
  fuelType      FuelType
  engine        String
  horsePower    Int
  seats         Int
  doors         Int
  color         String
  mileage       String       @default("Unlimited")
  location      String

  rating        Float        @default(0)
  reviews       Int          @default(0)
  availability  Boolean      @default(true)
  featured      Boolean      @default(false)

  description   String
  features      String[]

  // ── ImageKit (single source of truth) ──
  // Each points at a MediaImage row; delivery URL = filePath + a named preset.
  heroImage     MediaImage?    @relation("VehicleHero", fields: [heroImageId], references: [id], onDelete: SetNull)
  heroImageId   String?
  coverImage    MediaImage?    @relation("VehicleCover", fields: [coverImageId], references: [id], onDelete: SetNull)
  coverImageId  String?
  thumbnail     MediaImage?    @relation("VehicleThumbnail", fields: [thumbnailId], references: [id], onDelete: SetNull)
  thumbnailId   String?
  gallery       VehicleImage[]

  bookings      Booking[]

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([category])
  @@index([featured])
}

model VehicleImage {
  id          String     @id @default(cuid())

  image       MediaImage @relation(fields: [imageId], references: [id], onDelete: Cascade)
  imageId     String

  alt         String     @default("")
  // front | rear | side | left | right | interior | exterior | dashboard |
  // engine | wheel | 360 | thumbnail | gallery — free-form, not DB-enforced.
  tag         String?
  isHero      Boolean    @default(false)
  isCover     Boolean    @default(false)
  displayOrder Int       @default(0)

  vehicle     Vehicle    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId   String

  @@index([vehicleId, displayOrder])
  @@index([imageId])
}

model User {
  id        String       @id @default(cuid())
  name      String
  email     String       @unique
  password  String
  role      Role         @default(CUSTOMER)
  status    UserStatus   @default(ACTIVE)

  bookings      Booking[]
  refreshTokens RefreshToken[]
  uploads       MediaImage[]   @relation("UploadedBy")
  auditLogs     AuditLog[]

  createdById String?
  createdBy   User?     @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers User[]   @relation("UserCreatedBy")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([role])
}

/// ImageKit asset. NO local file paths, NO Cloudinary/Cloudflare fields —
/// ImageKit metadata only. `fileId` is ImageKit's canonical reference
/// (used to delete/rename via the SDK); `filePath` + `url` are what every
/// delivery URL is derived from via `tr=` transformation params — never a
/// pre-registered named variant, ImageKit resizes on the fly per request.
model MediaImage {
  id           String   @id @default(cuid())

  fileId       String   @unique
  filePath     String   // e.g. /mideeye-motors/vehicles/<slug>/front.jpg
  url          String   // base ImageKit delivery URL, no transform params
  thumbnailUrl String?

  width        Int?
  height       Int?
  size         Int?
  mimeType     String?

  altText      String   @default("")
  caption      String   @default("")
  folder       String?  // ImageKit real folder path
  tags         String[]

  uploadedBy   User?    @relation("UploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedById String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // ── usage (for the Media Library's "used vs unused" + usage tracking) ──
  vehicleImages  VehicleImage[]
  vehicleHero    Vehicle[]      @relation("VehicleHero")
  vehicleCover   Vehicle[]      @relation("VehicleCover")
  vehicleThumb   Vehicle[]      @relation("VehicleThumbnail")
  brandingLogo   Branding[]     @relation("BrandingLogo")
  brandingFavicon Branding[]    @relation("BrandingFavicon")
  brandingHero   Branding[]     @relation("BrandingHero")

  @@index([folder])
}

/// Singleton row (id "default") holding site-wide branding + contact info.
/// Image fields reference MediaImage — never a raw URL or local path.
model Branding {
  id            String      @id @default("default")

  logo          MediaImage? @relation("BrandingLogo", fields: [logoImageId], references: [id], onDelete: SetNull)
  logoImageId   String?
  favicon       MediaImage? @relation("BrandingFavicon", fields: [faviconImageId], references: [id], onDelete: SetNull)
  faviconImageId String?
  heroImage     MediaImage? @relation("BrandingHero", fields: [heroImageId], references: [id], onDelete: SetNull)
  heroImageId   String?

  primaryColor  String      @default("#0b67c2")
  phone         String      @default("")
  email         String      @default("")
  socials       Json?

  updatedAt     DateTime    @updatedAt
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String   // e.g. MEDIA_UPLOAD, USER_SUSPEND, VEHICLE_UPDATE
  entity     String   // e.g. MediaImage, User, Vehicle
  entityId   String?
  metadata   Json?
  ip         String?

  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId    String?

  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entity])
}

model Booking {
  id             String        @id @default(cuid())
  reference      String        @unique @default(cuid())

  vehicle        Vehicle       @relation(fields: [vehicleId], references: [id])
  vehicleId      String
  user           User?         @relation(fields: [userId], references: [id])
  userId         String?

  pickupLocation String
  dropoffLocation String
  pickupDate     DateTime
  returnDate     DateTime

  // Contact details captured at checkout (guest bookings have no userId).
  customerName   String?
  customerEmail  String?
  customerPhone  String?

  extras         String[]
  insurance      String        @default("basic")

  days           Int
  subtotal       Int
  tax            Int
  total          Int

  status         BookingStatus @default(PENDING)
  createdAt      DateTime      @default(now())

  @@index([vehicleId])
  @@index([userId])
}
