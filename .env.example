# ─────────────────────────────────────────────────────────────
# Mideeye Motors — environment template
# Copy to .env for the backend and frontend/.env for the web app.
# ─────────────────────────────────────────────────────────────

# ── Database (PostgreSQL) ──
DATABASE_URL="postgresql://mideeye:mideeye@localhost:5432/mideeye?schema=public"

# ── Redis ──
REDIS_URL="redis://localhost:6379"

# ── Auth ──
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# ── Cloudinary (SINGLE SOURCE OF TRUTH FOR ALL IMAGES) ──
# Server needs the full credential set for signed uploads/deletes.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
CLOUDINARY_FOLDER="mideeye-motors"

# ── Server ──
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# ── Frontend (Vite) — prefix VITE_ so they are exposed to the browser ──
VITE_API_URL="http://localhost:4000/api"
# Only the cloud name is public — never expose the API secret to the browser.
VITE_CLOUDINARY_CLOUD_NAME="your-cloud-name"
# Cloudinary publicId of the OFFICIAL logo (upload it once via the Media Manager).
VITE_LOGO_PUBLIC_ID="mideeye-motors/brand/logo"
