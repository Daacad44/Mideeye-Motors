# ─────────────────────────────────────────────────────────────
# Mideeye Motors — environment template
# Copy to .env for the backend and frontend/.env for the web app.
# ─────────────────────────────────────────────────────────────

# ── Database (PostgreSQL) ──
DATABASE_URL="postgresql://mideeye:mideeye@localhost:5432/mideeye?schema=public"

# ── Redis ──
REDIS_URL="redis://localhost:6379"

# ── Auth ──
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# ── ImageKit (SINGLE SOURCE OF TRUTH FOR ALL IMAGES) ──
# IMAGEKIT_PRIVATE_KEY is server-side only — it NEVER reaches the browser.
# Find these in the ImageKit dashboard → Developer Options → API Keys.
IMAGEKIT_PUBLIC_KEY="public_xxxxxxxxxxxxxxxxxxxxxxxxxxx"
IMAGEKIT_PRIVATE_KEY="private_xxxxxxxxxxxxxxxxxxxxxxxxxxx"
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_imagekit_id"

# ── Seed accounts (idempotent — safe to leave as defaults) ──
SEED_SUPER_ADMIN_EMAIL="daacaddeveloper@gmail.com"
SEED_SUPER_ADMIN_PASSWORD="Daacad@44Xxv"
SEED_ADMIN_EMAIL="admin@mideeyemotors.com"
SEED_ADMIN_PASSWORD="admin1234"

# ── Server ──
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# ── Frontend (Vite) — prefix VITE_ so they are exposed to the browser ──
VITE_API_URL="http://localhost:4000/api"
# Only the public key + URL endpoint are public — never expose the private key.
VITE_IMAGEKIT_PUBLIC_KEY="public_xxxxxxxxxxxxxxxxxxxxxxxxxxx"
VITE_IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_imagekit_id"
