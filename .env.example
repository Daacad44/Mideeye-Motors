# ─────────────────────────────────────────────────────────────
# Daljir Rental Car — environment template
# Copy to .env for the backend and frontend/.env for the web app.
# ─────────────────────────────────────────────────────────────

# ── Database (PostgreSQL) ──
DATABASE_URL="postgresql://daljir:change-me@localhost:5432/daljir?schema=public"
# docker-compose only (required there, no default):
POSTGRES_PASSWORD=""

# ── Redis ──
REDIS_URL="redis://localhost:6379"

# ── Auth ──
# REQUIRED in production: at least 32 random characters (openssl rand -hex 32).
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# ── ImageKit (SINGLE SOURCE OF TRUTH FOR ALL IMAGES) ──
# IMAGEKIT_PRIVATE_KEY is server-side only — it NEVER reaches the browser.
# Find these in the ImageKit dashboard → Developer Options → API Keys.
IMAGEKIT_PUBLIC_KEY="public_xxxxxxxxxxxxxxxxxxxxxxxxxxx"
IMAGEKIT_PRIVATE_KEY="private_xxxxxxxxxxxxxxxxxxxxxxxxxxx"
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_imagekit_id"

# ── Seed accounts (first boot only; existing accounts are never changed) ──
# Never commit real values. In production an account with no email/password
# is skipped; in development a random password is generated and printed once.
# Passwords must be at least 10 characters.
SEED_SUPER_ADMIN_EMAIL=""
SEED_SUPER_ADMIN_PASSWORD=""
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# ── Public site URL (password-reset links) ──
FRONTEND_URL="http://localhost:5173"

# ── Email (optional; unset ⇒ logged to the console) ──
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Daljir Rental Car <no-reply@daljirrentalcar.com>"

# ── SMS (optional) — "console" logs, "twilio" sends for real ──
SMS_PROVIDER="console"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# ── Payments ──
# The "mock" provider confirms a booking with no money moving. It is ON in
# development and OFF in production unless this is set to "true" (staging only).
PAYMENTS_ALLOW_MOCK="false"

# ── Server ──
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# ── Frontend (Vite) — prefix VITE_ so they are exposed to the browser ──
VITE_API_URL="http://localhost:4000/api"
# Only the public key + URL endpoint are public — never expose the private key.
VITE_IMAGEKIT_PUBLIC_KEY="public_xxxxxxxxxxxxxxxxxxxxxxxxxxx"
VITE_IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_imagekit_id"
# USD → SOS display rate for the currency toggle (display-only; USD is always
# the charged/stored currency). Update as the exchange rate moves. Default: 570.
VITE_USD_TO_SOS="570"
